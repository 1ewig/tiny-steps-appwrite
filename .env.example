# ==============================================================================
# SERVER-SIDE ONLY SECRETS (Must NEVER be prefixed with NEXT_PUBLIC_)
# ==============================================================================

# Vercel AI Gateway Configuration
# Get your API key from the Vercel AI Gateway dashboard: https://vercel.com/dashboard/ai-gateway
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_api_key_here

# Default model to route through AI Gateway (format: provider/model-name)
# Recommended: google/gemini-2.5-flash-lite (Fast, empathetic, 100% structuredOutputs support)
AI_MODEL=google/gemini-2.5-flash-lite

# Reasoning effort for AI models that support it: 'low' | 'high' (defaults to 'low')
AI_REASONING_EFFORT=low

# Optional: Gateway Base URL (defaults to https://ai-gateway.vercel.sh/v4/ai)
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v4/ai

# Optional: Appwrite Server Admin API Key (Server-side operations only, never exposed to browser)
APPWRITE_API_KEY=your_appwrite_api_key

# ==============================================================================
# CLIENT-SAFE ENVIRONMENT VARIABLES (Safe to be exposed in browser via NEXT_PUBLIC_)
# ==============================================================================

# Appwrite Cloud Configuration
# Note: In Appwrite architecture, Project ID and Database ID are public client identifiers.
# Data access is strictly secured via Row-Level Security (RLS) and user session permissions.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sfo.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_appwrite_project_id
NEXT_PUBLIC_APPWRITE_DATABASE_ID=your_appwrite_database_id

# Optional: Public deployment URL for SEO metadataBase (leave unset or fill upon deployment)
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
