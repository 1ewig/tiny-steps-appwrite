{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "react",
    "nextjs",
    "unicorn",
    "oxc"
  ],
  "ignorePatterns": [
    ".next",
    "node_modules",
    "dist",
    "build"
  ],
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off"
  }
}
